# uv environment and caches
.venv/
.python/
.cache/
.config/
.local/
.tools/
__pycache__/

# outputs, datasets, checkpoints (large; logs contain absolute paths)
out/
data/
*.ckpt
*.h5
*.hdf5
*.mp4
*.log

# local state (license consent is recorded per user, not shipped)
environment/
.migration-backup/

# credentials and keys (never commit)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
.netrc
credentials*.json
